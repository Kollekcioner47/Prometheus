# Фрагмент /etc/grafana/grafana.ini: только те настройки,
# которые меняются в практике 5.
#
# В файле настроек Grafana сотни параметров; менять их все
# в курсе не нужно. Здесь три изменения, и у каждого есть причина.

[server]
# Порт Grafana. В курсе 3000.
# В практике 7 тот же стек в Docker публикует Grafana на 3001 —
# именно для того, чтобы не столкнуться с этой службой.
http_port = 3000

[security]
# Начальный администратор. Параметр admin_password действует
# ТОЛЬКО при первой инициализации базы Grafana. Если база уже
# создана, смена этого параметра пароль не изменит: нужен
# grafana-cli admin reset-admin-password.
#
# Учебный пароль Console47 взят из стенда курса. В рабочей среде
# так делать нельзя: пароль администратора Grafana не должен
# совпадать ни с чем.
admin_user = admin
admin_password = Console47

[users]
# Запрет самостоятельной регистрации.
# По умолчанию Grafana разрешает регистрацию, и если её порт
# открыт в сеть, через неделю в ней появятся учётные записи,
# о которых никто не знает, — с правом просмотра метрик.
allow_sign_up = false

[auth.anonymous]
# Анонимный доступ выключен: дашборды видят только те,
# у кого есть учётная запись.
enabled = false
