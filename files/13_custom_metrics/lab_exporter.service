[Unit]
Description=lab_exporter - экспортёр очереди разовых заданий
Documentation=file:/opt/lab_exporter/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lab_exporter
Group=lab_exporter
WorkingDirectory=/opt/lab_exporter
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/lab_exporter/venv/bin/python /opt/lab_exporter/app.py --port 9200
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
